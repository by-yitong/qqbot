# 复制本文件为 ".env" 并填入你的值。
# 程序启动时由 godotenv 加载本文件到环境变量；真实环境变量始终优先。

# === 官方机器人配置（必填，去 q.qq.com 后台获取）===
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# === 机器人框架配置（qqbot/bot）===
# 命令前缀（可选；多个用 | 分隔，默认 /；命中前缀会去掉再匹配命令）
BOT_PREFIXES=/
# 主人 openid（逗号分隔多个）：OwnerOnly 命令（如 /webhook）仅主人可用。
# 不配置 = 这些命令对所有人拒绝（fail-closed）。自己的 openid 用 /id 命令查。
BOT_OWNERS=

# === 上线通知（在 main.go 里配置，非 env）===
# plugins.NewOnline("频道id", "🤖 机器人已上线").Group("群openid").User("私聊openid")
# 频道一直可主动发；群/私聊的主动发送需在 q.qq.com 开通「主动消息」权限。

# === Agent 兜底（未命中命令时交给 agent；留空 AI_API_KEY 则不启用）===
# 兼容 OpenAI / DeepSeek / Moonshot / OpenRouter 等 /v1/chat/completions 接口
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
# 换成视觉模型（如 glm-4.6v / gpt-4o / qwen-vl 系列）即可让机器人看懂用户发的图片
AI_MODEL=deepseek-chat
# 系统人设（可选；留空则用内置默认人设。system prompt 还会自动拼上：Available tools +
# 各工具的使用要点 Guidelines、以及技能索引——这些都随当前启用的工具动态生成）
AI_SYSTEM_PROMPT=

# === Agent harness 配置（均可选）===
# 工具循环上限（默认 8）；单次 Run 总时长上限默认 240s（守住 5min 被动回复窗口）
AGENT_MAX_ITERATIONS=
AGENT_LOOP_TIMEOUT=

# 多轮记忆：每用户(openid)对话历史落盘目录。设了就有多轮记忆（air 热重载也不丢）
AGENT_HISTORY_DIR=./data/sessions

# 上下文压缩：token 估算超阈值时自动摘要旧消息、保留近期窗口。设为 0 关闭
AGENT_COMPACTION_THRESHOLD=6000
# 压缩时保留的近期消息条数（默认 10）
AGENT_KEEP_RECENT=

# 技能：加载该目录下所有 *.md（YAML frontmatter + 正文），注入 system prompt
AGENT_SKILLS_DIR=./skills

# 聊天记忆（SQLite/GORM）：群+私聊消息全量落库（含未 @bot 的群聊，需全量消息权限），
# 供 search_history 工具按需深查 + 每次进 agent 时自动注入近期动态。设 0 关闭。
# LLM token 用量也记在这张库（llm_usages 表），.usage 命令查今日/累计。
AGENT_MEMORY=1
AGENT_MEMORY_DB=./data/memory.db
# 群聊记录增量并入 session：每次 @bot 把「上次 @bot 到这次之间」的新消息并进 session
# （持久消息、下轮自动加载；没人说话就不注入）。增量覆盖点落盘、重启无缝续上；
# 新群首次接触按下面的窗口全量铺底：
AGENT_RECENT_WINDOW=60
AGENT_RECENT_MAX=30
AGENT_GAP_MARKERS=./data/gap_markers.json

# 补充（steering）：agent 处理中再 @bot 发消息会并入当前处理（turn 边界生效，不打断在飞的工具）。
# 入队成功后回一句轻确认；设 0 关闭确认。停止当前处理用命令 .stop，清会话短期记忆用 .reset，
# 查看状态用 .status（命令前缀同 BOT_PREFIXES）。
AGENT_STEER_ACK=1

# 自定义菜单 + 指令面板（官方新接口）：启动自动发布（设 0 关闭）；
# menu.json 可覆盖内置默认（见 menu.json.example）；.menu apply/clear 手动管理。
AGENT_MENU=1
AGENT_MENU_CONFIG=./menu.json

# MCP：连接 mcp.json 里的 MCP server，工具并入 agent（见 mcp.json.example）。
# 对话里 /mcp 或让 AI 调 mcp_add 动态添加的 server 落到 AGENT_RUNTIME_MCP，重启自动重连
AGENT_MCP_CONFIG=./mcp.json
AGENT_RUNTIME_MCP=./data/mcp_runtime.json

# http_get 工具的 SSRF 放行名单（逗号分隔，默认拒内网/回环）
# SSRF 放行名单（逗号分隔，默认拒内网/回环）：http_get 与站长诊断工具
# （ping/tcp_ping/cert_info 及 /ping 命令）共用
AGENT_HTTP_ALLOW=

# anysearch 联网搜索工具（web_search / web_extract）。API key 可选（匿名低限额）
# 去 https://anysearch.com/console/api-keys 获取
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=

# 生图工具 generate_image（OpenAI 协议，文生图 + 图生图）。有 IMAGE_API_KEY 才注册。
# 网关若只回 base64（如 gpt-image 系列），工具自动存进程内图床返回 genimg: 引用，
# AI 再调 send_image(url=引用) 发出——base64 不会进 LLM 上下文。
# BASE_URL 必须含 /v1（OpenAI 协议路径），如 https://api.openai.com/v1 或第三方网关。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# 生成的图本地归档目录（默认 ./data/images；设空则不落盘，只在内存图床）
IMG_SAVE_DIR=./data/images

# 图床（QQ 发图必需）：QQ 群/私聊 /files 的 multipart 直传已废，改用 URL 模式
# （给 url 让 QQ 自己下载）。两种模式见 docs/agent.md「图床」一节：
#   A. 本地直存：bot 在公网服务器上，设 IMGHOST_LOCAL_DIR（如 ./data/files），文件写进
#      该目录，由本机 nginx/caddy 等把目录映射成公网路径；IMGHOST_BASE_URL 填该公网地址。
#   B. 远端图床：不设 IMGHOST_LOCAL_DIR，部署 cmd/imghost 到公网服务器并填 token。
# IMGHOST_BASE_URL 不填 → 生成的图只在本地，QQ 发不出。
IMGHOST_BASE_URL=
IMGHOST_LOCAL_DIR=
IMGHOST_TOKEN=

# === 定时任务（scheduler）===
# agent 可在对话里自主创建（「每天8点给我发新闻摘要」）；插件也可声明自己的定时逻辑。
# 任务落盘文件；重启自动恢复（错过的周期任务不补跑，滚到下个计划点；单次标记过期）
TASK_FILE=./data/tasks.json
# 计划时区（每天几点 / 每周几按此时区解释）
TASK_TZ=Asia/Shanghai
# 任务数量上限：单聊天 / 全局（对话里创建的任务计；插件声明的不计）
TASK_MAX_PER_CHAT=10
TASK_MAX_TOTAL=100
# 每日笑话（Happy 插件的定时任务示范）发送目标：group:群openid / channel:子频道id / c2c:用户openid
# 留空不启用。群/私聊主动消息需在 q.qq.com 开通权限（频道无限制）
HAPPY_DAILY_TARGET=

# === 危险工具（默认关；公开 bot 强烈不建议开启）===
# 开启 bash 工具（⚠️ 等于把服务器 shell 暴露给所有能发消息的人）
AGENT_ENABLE_BASH=0
# bash 工作目录（可选）；白名单（逗号分隔，非空则只允许这些首 token 命令且禁元字符）
AGENT_BASH_CWD=
AGENT_BASH_ALLOW=
# 开启文件读写工具（限定在下面的根目录内）
AGENT_ENABLE_FS=0
AGENT_FS_ROOT=./data/fs

# 注意：官方机器人默认只能被动回复（收到消息后 5 分钟内），群消息需 @ 机器人；
# 主动消息（上线通知/入群欢迎等）需在 q.qq.com 开通「主动消息」权限。

# === 入群欢迎（官方 2026-08 新增 GROUP_MEMBER_ADD 事件）===
# 欢迎文案模板，{name} 会替换成新成员昵称（取不到时用「新朋友」）。留空不启用。
# 注意：入群事件没有回复锚点，欢迎语走主动消息——需在 q.qq.com 开通主动消息权限
#（频控：单群 1000 条/天，入群频率低足够用）。
WELCOME_TEXT=欢迎 {name} 加入本群！🎉
# 限定启用的群 openid（逗号分隔；留空 = 所有群）
WELCOME_GROUPS=

# === 入群申请自动审批（官方 2026-08 新增 GROUP_JOIN_REQUEST 事件）===
# 匹配模式 JOIN_REVIEW_MATCH：
#   exact（默认）  = 每个答案精确命中 JOIN_REVIEW_ANSWERS 才放行，适合口令式问题；
#   contains      = 每个答案包含任一关键词即放行，适合开放式问题，
#                   如「Go中如何声明变量？」配 var|:= ，答 "var x int"/"x := 10" 都放行；
#   ai            = 把问题与回答交给 LLM 判对错（需配置 AI_API_KEY）。
#                   **多群零配置**：群管理后台设了入群问答的群，事件自带问题原文，
#                   AI 直接判「答对没有」，每个群的问题各不相同也不用配答案；
#                   纯验证消息（verify_message）模式事件里没有问题原文，需用
#                   JOIN_REVIEW_AI_RULE 配一条全局判定标准。
#                   AI 调用失败时回退 JOIN_REVIEW_ANSWERS 精确匹配（配了才有），再不行留人工。
# 判定不通过默认留给群管理人工处理，JOIN_REVIEW_DECLINE=1 改为自动拒绝并附理由。
# 前提：机器人需是群管理员（否则收不到申请事件）。
JOIN_REVIEW_ANSWERS=
JOIN_REVIEW_MATCH=exact
JOIN_REVIEW_AI_RULE=
JOIN_REVIEW_DECLINE=0
# 限定启用的群 openid（逗号分隔；留空 = 所有收得到事件的群）
JOIN_REVIEW_GROUPS=
# 允许使用「审批」命令的用户 openid（逗号分隔；留空 = 不限制，自用场景）
JOIN_ADMINS=

# === 群成员禁言（官方 2026-08 新增 restrict_chat_setting 接口）===
# MUTE_ENABLE=1 启用 /禁言 /解禁 命令（仅主人可用：BOT_OWNERS 里的 openid，
# fail-closed——未配置主人时无人可用；自己的 openid 用 /id 命令查）。目标用 @ 指定：
#   /禁言 @某人 10分钟   支持中文单位（30秒/10分钟/2小时/1天/1周）与字母
#                       （30s/10m/2h/1d/1w），裸数字按分钟；一次 @ 多人批量禁言。
#   /解禁 @某人         解除禁言。
# 官方限制：机器人需是群管理员；只能禁言普通成员（群主/管理员/机器人本身不行）；
# 单次最多 10 人；最长 30 天。
MUTE_ENABLE=0
# 限定启用的群 openid（逗号分隔；留空 = 所有群）
MUTE_GROUPS=

# === 群成员管理与群黑名单（官方 2026-09 新增成员/黑名单接口，内邀白名单机制）===
# MEMBER_ENABLE=1 启用命令（官方白名单接口，未获平台内邀接入的机器人调用会报
# 11253 应用无接口访问权限，需联系平台运营申请）：
#   /成员              群成员概览（人数/群主/管理员/成员昵称前 30）
#   /成员 @某人        成员详情（角色/入群时间/完整 openid）
#   /成员 关键词       按昵称搜成员
#   /黑名单            查看群黑名单
#   /踢 @某人 [拉黑]   移出群（加「拉黑」同时拉入群黑名单），仅群主/群管理员或主人
#   /拉黑 openid…      加入群黑名单（仅限已不在群中的人），仅群主/群管理员或主人
#   /解除拉黑 openid…  移出群黑名单，仅群主/群管理员或主人
# 官方限制：单次移除/黑名单操作最多 20 人；机器人需是群管理员。
MEMBER_ENABLE=0
# 限定启用的群 openid（逗号分隔；留空 = 所有群）
MEMBER_GROUPS=

# 宝塔面板状态插件（/panel），配置后才启用
BT_PANEL_URL=
BT_PANEL_KEY=

# 图床上传插件（/图床）：把图片和「图床」命令一起发给 bot（群里要 @ 它），bot 下载原图
# 后转存到图床并回复公网外链。配置 IMGBED_TOKEN 才启用；单图上限默认 10MB（可调）。
IMGBED_BASE_URL=https://imgbed.jmwl.dpdns.org
IMGBED_TOKEN=
IMGBED_MAX_MB=10

# Webhook 推送插件：群内 /webhook 生成地址，外部 POST 消息进群；配置监听地址才启用。
# /webhook 仅主人可用（BOT_OWNERS）；地址走私聊发给主人、不在群里回（防 sign 泄露），
# 群里触发但私聊发送失败时，去私聊窗口发 /webhook <群openid> 重取（被动回复，必达）
WEBHOOK_LISTEN=:8081
WEBHOOK_BASE_URL=http://xxxx.cn
