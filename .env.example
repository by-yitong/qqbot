# 复制本文件为 ".env" 并填入你的值。
# 程序启动时由 godotenv 加载本文件到环境变量；真实环境变量始终优先。

# === 官方机器人配置（必填，去 q.qq.com 后台获取）===
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# === 机器人框架配置（qqbot/bot）===
# 命令前缀（可选；多个用 | 分隔，默认 /；命中前缀会去掉再匹配命令）
BOT_PREFIXES=/

# === 上线通知（在 main.go 里配置，非 env）===
# plugins.NewOnline("频道id", "🤖 机器人已上线").Group("群openid").User("私聊openid")
# 频道一直可主动发；群/私聊的主动发送需在 q.qq.com 开通「主动消息」权限。

# === Agent 兜底（未命中命令时交给 agent；留空 AI_API_KEY 则不启用）===
# 兼容 OpenAI / DeepSeek / Moonshot / OpenRouter 等 /v1/chat/completions 接口
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 系统人设（可选；留空则用内置默认人设。system prompt 还会自动拼上：Available tools +
# 各工具的使用要点 Guidelines、以及技能索引——这些都随当前启用的工具动态生成）
AI_SYSTEM_PROMPT=

# === Agent harness 配置（均可选）===
# 工具循环上限（默认 8）；单次 Run 总时长上限默认 240s（守住 5min 被动回复窗口）
AGENT_MAX_ITERATIONS=
AGENT_LOOP_TIMEOUT=

# 多轮记忆：每用户(openid)对话历史落盘目录。设了就有多轮记忆（air 热重载也不丢）
AGENT_HISTORY_DIR=./data/sessions

# 上下文压缩：token 估算超阈值时自动摘要旧消息、保留近期窗口。设为 0 关闭
AGENT_COMPACTION_THRESHOLD=6000
# 压缩时保留的近期消息条数（默认 10）
AGENT_KEEP_RECENT=

# 技能：加载该目录下所有 *.md（YAML frontmatter + 正文），注入 system prompt
AGENT_SKILLS_DIR=./skills

# 聊天记忆（SQLite/GORM）：群+私聊消息全量落库（含未 @bot 的群聊，需全量消息权限），
# 供 search_history 工具按需深查 + 每次进 agent 时自动注入近期动态。设 0 关闭。
# LLM token 用量也记在这张库（llm_usages 表），.usage 命令查今日/累计。
AGENT_MEMORY=1
AGENT_MEMORY_DB=./data/memory.db
# 群聊记录增量并入 session：每次 @bot 把「上次 @bot 到这次之间」的新消息并进 session
# （持久消息、下轮自动加载；没人说话就不注入）。增量覆盖点落盘、重启无缝续上；
# 新群首次接触按下面的窗口全量铺底：
AGENT_RECENT_WINDOW=60
AGENT_RECENT_MAX=30
AGENT_GAP_MARKERS=./data/gap_markers.json

# 补充（steering）：agent 处理中再 @bot 发消息会并入当前处理（turn 边界生效，不打断在飞的工具）。
# 入队成功后回一句轻确认；设 0 关闭确认。停止当前处理用命令 .stop，清会话短期记忆用 .reset，
# 查看状态用 .status（命令前缀同 BOT_PREFIXES）。
AGENT_STEER_ACK=1

# 自定义菜单 + 指令面板（官方新接口）：启动自动发布（设 0 关闭）；
# menu.json 可覆盖内置默认（见 menu.json.example）；.menu apply/clear 手动管理。
AGENT_MENU=1
AGENT_MENU_CONFIG=./menu.json

# MCP：连接 mcp.json 里的 MCP server，工具并入 agent（见 mcp.json.example）。
# 对话里 /mcp 或让 AI 调 mcp_add 动态添加的 server 落到 AGENT_RUNTIME_MCP，重启自动重连
AGENT_MCP_CONFIG=./mcp.json
AGENT_RUNTIME_MCP=./data/mcp_runtime.json

# http_get 工具的 SSRF 放行名单（逗号分隔，默认拒内网/回环）
AGENT_HTTP_ALLOW=

# anysearch 联网搜索工具（web_search / web_extract）。API key 可选（匿名低限额）
# 去 https://anysearch.com/console/api-keys 获取
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=

# 生图工具 generate_image（OpenAI 协议，文生图 + 图生图）。有 IMAGE_API_KEY 才注册。
# 网关若只回 base64（如 gpt-image 系列），工具自动存进程内图床返回 genimg: 引用，
# AI 再调 send_image(url=引用) 发出——base64 不会进 LLM 上下文。
# BASE_URL 必须含 /v1（OpenAI 协议路径），如 https://api.openai.com/v1 或第三方网关。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# 生成的图本地归档目录（默认 ./data/images；设空则不落盘，只在内存图床）
IMG_SAVE_DIR=./data/images

# 图床（QQ 发图必需）：QQ 群/私聊 /files 的 multipart 直传已废，改用 URL 模式
# （给 url 让 QQ 自己下载）。两种模式见 README「图床」一节：
#   A. 本地直存：bot 在公网服务器上，设 IMGHOST_LOCAL_DIR（如 ./data/files），文件写进
#      该目录，由本机 nginx/caddy 等把目录映射成公网路径；IMGHOST_BASE_URL 填该公网地址。
#   B. 远端图床：不设 IMGHOST_LOCAL_DIR，部署 cmd/imghost 到公网服务器并填 token。
# IMGHOST_BASE_URL 不填 → 生成的图只在本地，QQ 发不出。
IMGHOST_BASE_URL=
IMGHOST_LOCAL_DIR=
IMGHOST_TOKEN=

# === 定时任务（scheduler）===
# agent 可在对话里自主创建（「每天8点给我发新闻摘要」）；插件也可声明自己的定时逻辑。
# 任务落盘文件；重启自动恢复（错过的周期任务不补跑，滚到下个计划点；单次标记过期）
TASK_FILE=./data/tasks.json
# 计划时区（每天几点 / 每周几按此时区解释）
TASK_TZ=Asia/Shanghai
# 任务数量上限：单聊天 / 全局（对话里创建的任务计；插件声明的不计）
TASK_MAX_PER_CHAT=10
TASK_MAX_TOTAL=100
# 每日笑话（Happy 插件的定时任务示范）发送目标：group:群openid / channel:子频道id / c2c:用户openid
# 留空不启用。群/私聊主动消息需在 q.qq.com 开通权限（频道无限制）
HAPPY_DAILY_TARGET=

# === 危险工具（默认关；公开 bot 强烈不建议开启）===
# 开启 bash 工具（⚠️ 等于把服务器 shell 暴露给所有能发消息的人）
AGENT_ENABLE_BASH=0
# bash 工作目录（可选）；白名单（逗号分隔，非空则只允许这些首 token 命令且禁元字符）
AGENT_BASH_CWD=
AGENT_BASH_ALLOW=
# 开启文件读写工具（限定在下面的根目录内）
AGENT_ENABLE_FS=0
AGENT_FS_ROOT=./data/fs

# 注意：官方机器人只能被动回复（收到消息后 5 分钟内），群消息需 @ 机器人。
# 没有群管（踢人/禁言）、上线通知、主动发送等能力（官方 API 不支持）。
